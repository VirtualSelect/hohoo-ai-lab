      "raw": "{\"claims\":[{\"field\":\"read_timeout_ms\",\"value\":\"2000\",\"doc\":\"prod-v2\",\"quote\":\"read_timeout_ms=5000\"},{\"field\":\"retry_enabled\",\"value\":\"false\",\"doc\":\"prod-v2\",\"quote\":\"retry_enabled=false\"}]}",
      "request": {
        "service": "payments",
