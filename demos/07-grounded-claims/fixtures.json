      "raw": "{\"claims\":[{\"field\":\"retry_enabled\",\"value\":\"false\",\"doc\":\"prod-v2\",\"quote\":\"retry_enabled=false\"},{\"field\":\"read_timeout_ms\",\"value\":\"5000\",\"doc\":\"prod-v2\",\"quote\":\"read_timeout_ms=5000\"}]}",
