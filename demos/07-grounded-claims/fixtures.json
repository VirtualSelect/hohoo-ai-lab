      "raw": "{\"claims\":[{\"field\":\"read_timeout_ms\",\"value\":\"5000\",\"doc\":\"prod-v2\",\"quote\":\"read_timeout_ms=5000\"}]}",
      "request": {
        "service": "payments",
        "environment": "prod",
        "revision": "v2",
        "fields": [
          "read_timeout_ms"
        ],
        "supplied": [
          "prod-v2",
          "prod-v1",
          "dev-v2"
        ]
      },
      "expected": "ACCEPT"
    },
